pipeline {
    agent any
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'feature/backend', description: 'Enter the branch name to switch to')
        string(name: 'REPO_URL', defaultValue: '*', description: 'Enter the Git repository URL')
        string(name: 'MODULE_DIR', defaultValue: 'Ecommerce', description: 'Enter the directory containing the module to build and test')
    }
    stages {
        stage("Build") {
            steps {
                script {
                  checkout scmGit(branches: [[name: 'feature/backend']], extensions: [], userRemoteConfigs: [[credentialsId: '*', url: '*']])
                }
            }
        }
        stage("Compile") {
            steps {
                dir("${params.MODULE_DIR}") {
                    sh 'mvn compile'
                }
            }
        }
        stage("Test") {
            steps {
                dir("${params.MODULE_DIR}") {
                    sh 'mvn test'
                }
            }
        }

    }
}
